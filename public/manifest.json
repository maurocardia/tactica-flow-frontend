{
  "manifest_version": 3,
  "name": "Táctica Flow",
  "version": "1.0.0",
  "description": "Panel lateral para WhatsApp Web",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content-loader.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "*.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}